# ============================================
#  复制这个文件为 .env，填入你自己的密钥
#  命令：cp .env.example .env
#  .env 已被 .gitignore 挡住，绝不会上传 GitHub
# ============================================

# MiniMax API 密钥（在你充值的平台后台生成，别用泄露过的）
MINIMAX_API_KEY=在这里填你的新key

# MiniMax API 调用地址（按你平台文档填，下面是常见默认值）
MINIMAX_API_URL=https://api.minimaxi.com/v1/text/chatcompletion_v2

# MiniMax 模型名（按你平台文档填）
MINIMAX_MODEL=MiniMax-Text-01
